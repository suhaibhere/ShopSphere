# Copy to .env. Keep this file local; it contains development-only credentials.
POSTGRES_DB=shopsphere
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql://shopsphere:replace-with-a-random-local-password@localhost:5432/shopsphere?schema=public
SESSION_SECRET=replace-this-with-a-long-random-secret
VITE_API_BASE_URL=/api
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
